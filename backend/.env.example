# Copie para backend/.env.development (local) ou configure como variáveis de ambiente no servidor.
# ENVIRONMENT (variável do sistema) escolhe o arquivo: development (padrão) -> .env.development,
# production -> .env.production. Variáveis de ambiente reais sempre têm prioridade.

DATABASE_URL=postgresql+psycopg://postgres:SENHA@localhost:5432/HookahDriver

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção é obrigatório (mínimo 32 caracteres).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origens do frontend permitidas (separe várias por vírgula). A primeira é usada nos links de retorno.
FRONTEND_URL=http://localhost:5173
# URL pública desta API (usada no webhook do Mercado Pago; precisa ser https para ser enviada).
APP_BASE_URL=http://localhost:8000

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com

LOG_LEVEL=INFO
